/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
/themes/*/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/v/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.md
  Content-Type: text/markdown; charset=utf-8
/*.txt
  Content-Type: text/plain; charset=utf-8
/*.sql
  Content-Type: text/plain; charset=utf-8
