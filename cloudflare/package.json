{
  "name": "sitekeeper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node ../scripts/check-witness-compat.mjs && node --test ../scripts/check-witness-compat.test.mjs && node ../scripts/site-guide-contract.mjs && node --test scripts/beacon-check.mjs scripts/heading-check.mjs scripts/recovery-check.mjs scripts/alerts-ui-check.mjs scripts/theme-version-check.mjs scripts/skills-check.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "themes": "node scripts/themes.mjs",
    "theme:check": "node scripts/theme.mjs check",
    "theme:preview": "node scripts/theme.mjs preview"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@simplewebauthn/server": "14.0.2",
    "@types/mustache": "4.2.5",
    "agents": "0.24.0",
    "entities": "8.1.0",
    "mustache": "4.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/markdown-it": "14.1.2",
    "markdown-it": "14.3.3",
    "playwright-core": "^1.56.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  }
}
