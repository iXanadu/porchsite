// Sitekeeper on Cloudflare. One Worker; content in D1, OAuth state in KV.
{
  "name": "sitekeeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    { "binding": "DB", "database_name": "sitekeeper", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "observability": { "enabled": true, "redact_query_string": true }
  // New installs issue a hashed setup_codes row; no setup secret is needed.
  // Existing SETUP_CODE deployments remain compatible until claimed.
}
