# Copy to .env and fill in. Never commit .env.

# Your site's domain, bare (no www., no https://). Point its DNS (an A or
# AAAA record, and the same for www.) at this server before starting.
PORCHSITE_DOMAIN=example.com

# Optional, and best left empty: the owner claims the site from a link you
# make after the first start with
#   docker compose exec app python -m server.app.cli setup-link
# (see README.md). A code set here also works; empty it once the site is
# claimed, then run `docker compose up -d` again.
PORCHSITE_SETUP_CODE=

# The database password. Letters and digits only (it goes into a URL).
# Make one with: openssl rand -hex 24
# Set it before the first start: the database keeps the first one it sees.
PORCHSITE_DB_PASSWORD=

# The release you are running, shown in the X-Porchsite-Release header.
PORCHSITE_RELEASE=

# Optional. The site's address, if it isn't https://<domain>.
# PORCHSITE_SITE_URL=https://example.com
# Optional. Other host ports for Caddy, for a machine where 80/443 are taken
# (automatic certificates need 80 and 443 reachable from the internet).
# PORCHSITE_HTTP_PORT=80
# PORCHSITE_HTTPS_PORT=443
