<div class="card">
<h3>{{#link}}<a href="{{link}}">{{name}}</a>{{/link}}{{^link}}{{name}}{{/link}}{{#status}} <span class="flag">{{status}}</span>{{/status}}</h3>
{{#price}}<p class="price">{{price}}</p>
{{/price}}{{#subtitle}}<p class="sub">{{subtitle}}</p>
{{/subtitle}}<p>{{description}}</p>
{{#link}}<a class="more" href="{{link}}">{{link_text}} →</a>
{{/link}}</div>
