<article class="ticket{{#event.is_changed}} is-changed{{/event.is_changed}}{{#event.is_cancelled}} is-cancelled{{/event.is_cancelled}}">
{{#event.status}}<p class="ticket-status">{{event.status}}</p>
{{/event.status}}<div class="ticket-main">
<p class="stamp">{{event.date_short}}</p>
<h3 class="ticket-title"><a href="{{url}}">{{title}}</a></h3>
<p class="when">{{event.when}}</p>
{{#event.place_name}}<div class="where">
<p class="place">{{event.place_name}}</p>
{{#event.place_address}}<p class="addr">{{event.place_address}}</p>
{{/event.place_address}}{{^event.is_cancelled}}{{#event.map_link}}<a class="dir" href="{{event.map_link}}">{{strings.directions}} →</a>
{{/event.map_link}}{{/event.is_cancelled}}</div>
{{/event.place_name}}{{#summary}}<p class="sum">{{summary}}</p>
{{/summary}}{{^event.is_cancelled}}{{#event.rsvp_link}}<div class="rsvp">
<a class="b" href="{{event.rsvp_link}}">{{event.rsvp_label}}{{^event.rsvp_label}}{{page.cta_label}}{{/event.rsvp_label}}</a>
{{#event.rsvp_deadline}}<span class="deadline">{{event.rsvp_deadline}}</span>{{/event.rsvp_deadline}}
</div>
{{/event.rsvp_link}}{{/event.is_cancelled}}</div>
{{^event.is_cancelled}}{{#event.has_schedule}}<div class="sched">
<h4>{{strings.schedule}}</h4>
<ol>
{{#event.schedule}}<li><time>{{time}}</time><span><b>{{title}}</b>{{#note}}<small>{{note}}</small>{{/note}}</span></li>
{{/event.schedule}}</ol>
</div>
{{/event.has_schedule}}{{/event.is_cancelled}}</article>
