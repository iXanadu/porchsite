{{> head}}
<div class="hero{{#site.hero_image}} has-photo{{/site.hero_image}}">
<div class="hero-in">
<div class="hero-copy">
{{#site.logo}}<img class="hero-logo" src="{{site.logo}}" alt="{{site.logo_alt}}" width="72" height="72">
{{/site.logo}}<p class="hero-name">{{site.site_name}}</p>
<h1>{{site.tagline}}</h1>
{{#page.lede}}<p class="lede">{{page.lede}}</p>
{{/page.lede}}{{#has_writing}}<p class="ctas">
<a class="b b-light" href="{{page.cta_link}}">{{page.cta_label}}</a>
{{#hero_more}}<a class="b b-ghost" href="{{href}}">{{label}}</a>{{/hero_more}}
</p>
{{/has_writing}}</div>
{{#site.hero_image}}<figure class="hero-photo"><img src="{{site.hero_image}}" alt="{{page.hero_alt}}" width="{{site.hero_width}}" height="{{site.hero_height}}">{{#page.hero_caption}}<figcaption>{{page.hero_caption}}</figcaption>{{/page.hero_caption}}</figure>
{{/site.hero_image}}</div>
</div>
<div class="w">
{{#site.hours.has}}<section class="sec meet" id="meets">
<h2>{{strings.meets}}</h2>
<div class="meet-grid">
{{> times}}
{{#sections}}{{#is_entries}}{{#has_upcoming}}<div class="events" id="{{stream.anchor}}">
<h3 class="kicker">{{stream.title}}</h3>
{{#upcoming}}{{> event}}
{{/upcoming}}</div>
{{/has_upcoming}}{{/is_entries}}{{/sections}}</div>
</section>
{{/site.hours.has}}
{{#sections}}
{{#is_entries}}
{{#has_upcoming}}{{^site.hours.has}}<section class="sec meet" id="{{stream.anchor}}">
<h2>{{stream.title}}</h2>
{{#stream.byline}}<p class="byline">{{stream.byline}}</p>{{/stream.byline}}
<div class="events">
{{#upcoming}}{{> event}}
{{/upcoming}}</div>
</section>
{{/site.hours.has}}{{/has_upcoming}}
{{#has_earlier}}<section class="sec past"{{^has_upcoming}} id="{{stream.anchor}}"{{/has_upcoming}}>
<details class="earlier"{{^has_upcoming}} open{{/has_upcoming}}>
<summary>{{strings.earlier}}</summary>
<ul class="rows">
{{#earlier}}{{> row}}
{{/earlier}}</ul>
</details>
</section>
{{/has_earlier}}
{{^has_upcoming}}{{^has_earlier}}{{#show}}<section class="sec news" id="{{stream.anchor}}">
<h2>{{stream.title}}</h2>
{{#stream.byline}}<p class="byline">{{stream.byline}}</p>{{/stream.byline}}
{{#stream.intro}}<p>{{stream.intro}}</p>{{/stream.intro}}
{{#stream.is_feature}}<div class="news-grid">
{{#latest}}<article class="story">
{{#cover_src}}<img class="story-cover" src="{{cover_src}}" alt="{{cover_alt}}">
{{/cover_src}}<p class="date">{{date_long}}</p>
<h3><a href="{{url}}">{{title}}</a></h3>
{{#has_body}}<div class="body">{{{body_html}}}</div>{{/has_body}}{{^has_body}}<p>{{summary}}</p>{{/has_body}}
</article>
{{/latest}}{{#more_than_one}}<aside class="more-news">
<ul class="rows">
{{#items}}{{> row}}
{{/items}}</ul>
<p class="all"><a href="{{stream.archive_url}}">{{stream.all_label}}{{count_suffix}} →</a></p>
</aside>
{{/more_than_one}}</div>
{{/stream.is_feature}}
{{#stream.is_list}}<ul class="rows">
{{#items}}{{> row}}
{{/items}}</ul>
{{#more_than_one}}<p class="all"><a href="{{stream.archive_url}}">{{stream.all_label}}{{count_suffix}} →</a></p>{{/more_than_one}}
{{/stream.is_list}}
</section>
{{/show}}{{/has_earlier}}{{/has_upcoming}}
{{/is_entries}}
{{#is_cards}}{{#show}}<div class="cards-wrap" id="{{anchor}}">
{{#by_group}}<section class="sec group">
<h2>{{label}}{{^label}}{{title}}{{/label}}</h2>
<div class="cards">
{{#cards}}{{> card}}
{{/cards}}</div>
</section>
{{/by_group}}{{#has_open_source}}<section class="sec group">
<h2>{{open_source_label}}</h2>
<div class="cards">
{{#open_source}}{{> card}}
{{/open_source}}</div>
</section>
{{/has_open_source}}</div>
{{/show}}{{/is_cards}}
{{#is_about}}<section class="sec about" id="{{anchor}}">
<h2>{{title}}</h2>
<div class="about-text">
{{#paragraphs}}<p>{{.}}</p>
{{/paragraphs}}</div>
</section>
{{/is_about}}
{{/sections}}
{{#site.contact.has}}<section class="sec find" id="contact">
<h2>{{strings.contact}}</h2>
<div class="find-grid">
{{#site.contact.has_address}}<div class="find-box">
<address>{{#site.contact.address_lines}}{{line}}<br>{{/site.contact.address_lines}}</address>
{{#site.contact.map_link}}<a class="b" href="{{site.contact.map_link}}">{{strings.directions}}</a>
{{/site.contact.map_link}}</div>
{{/site.contact.has_address}}<div class="find-box">
{{#site.contact.phone}}<p><span class="lbl">{{strings.call}}</span> <a href="{{site.contact.phone_href}}">{{site.contact.phone}}</a></p>
{{/site.contact.phone}}{{#site.contact.email}}<p><span class="lbl">{{strings.email}}</span> <a href="{{site.contact.email_href}}">{{site.contact.email}}</a></p>
{{/site.contact.email}}{{#site.contact.has_social}}<p class="social">{{#site.contact.social}}<a href="{{url}}">{{kind}}</a> {{/site.contact.social}}</p>
{{/site.contact.has_social}}</div>
</div>
</section>
{{/site.contact.has}}
{{#site.has_buttons}}<ul class="buttons">
{{#site.buttons}}<li><a href="{{url}}"><b>{{label}}</b>{{#note}}<small>{{note}}</small>{{/note}}</a></li>
{{/site.buttons}}</ul>
{{/site.has_buttons}}
</div>
{{> foot}}
