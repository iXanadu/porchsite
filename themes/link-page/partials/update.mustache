<span class="upd-when">{{#event.has}}{{event.date_short}}{{/event.has}}{{^event.has}}{{date_short}}{{/event.has}}</span>
<span class="upd-title">{{title}}{{#event.has}}{{#event.status}} <em class="flag">{{event.status}}</em>{{/event.status}}{{/event.has}}</span>
