{{> head}}
<section class="hero"><div class="hero-copy"><div><p class="eyebrow">{{page.hero_caption}}</p><h1>{{site.tagline}}</h1><p class="intro">{{page.lede}}</p></div><div class="hero-actions">{{#page.cta_label}}<a class="button" href="{{page.cta_link}}">{{page.cta_label}} <span aria-hidden="true">↗</span></a>{{/page.cta_label}}{{#site.cta2_label}}<a class="text-link" href="{{site.cta2_link}}">{{site.cta2_label}} <span aria-hidden="true">↓</span></a>{{/site.cta2_label}}</div></div>
{{#site.hero_image}}<figure class="hero-photo"><img src="{{site.hero_image}}" alt="{{page.hero_alt}}" width="{{site.hero_width}}" height="{{site.hero_height}}" fetchpriority="high"></figure>{{/site.hero_image}}
</section>
{{#sections}}{{#is_entries}}{{#stream.is_feature}}{{#latest}}<section class="listing" id="{{stream.anchor}}">{{> stats}}<div class="listing-body">{{{body_html}}}</div></section>{{/latest}}{{/stream.is_feature}}{{#stream.is_list}}{{#show}}<section class="updates" id="{{stream.anchor}}"><h2>{{stream.title}}</h2>{{#items}}<a class="update" href="{{url}}"><span>{{date_short}}</span><span>{{title}}</span><span aria-hidden="true">↗</span></a>{{/items}}</section>{{/show}}{{/stream.is_list}}{{/is_entries}}{{/sections}}
{{> contact}}
{{> foot}}
