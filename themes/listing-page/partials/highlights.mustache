{{#has_highlights}}<section class="highlights" id="{{#site.cards_anchor}}{{site.cards_anchor}}{{/site.cards_anchor}}{{^site.cards_anchor}}cards{{/site.cards_anchor}}"><h2>{{site.cards_title}}</h2><div class="highlight-grid">{{#highlights}}<article class="highlight">{{#has_image}}<img src="{{image_src}}" alt="{{image_alt}}" loading="lazy">{{/has_image}}<div>{{#status}}<p class="eyebrow">{{status}}</p>{{/status}}<h3>{{name}}</h3>{{#subtitle}}<p class="highlight-subtitle">{{subtitle}}</p>{{/subtitle}}<p>{{description}}</p>{{#link}}<a class="text-link" href="{{link}}">{{link_text}} ↗</a>{{/link}}</div></article>{{/highlights}}</div></section>{{/has_highlights}}
