{{#site.hours.has}}<div class="panel hours" id="hours">
<div class="panel-head"><h2>{{strings.hours}}</h2><p class="status{{#site.hours.open_now}} is-open{{/site.hours.open_now}}"><span class="dot"></span>{{site.hours.status}}</p></div>
<table class="days">
{{#site.hours.days}}<tr class="{{#today}}today{{/today}}{{#closed}} shut{{/closed}}"><th scope="row">{{day}}</th><td>{{hours}}</td></tr>
{{/site.hours.days}}</table>
{{#site.hours.has_exceptions}}<div class="exceptions">
<h3 class="ex-head">{{strings.holiday_hours}}</h3>
<ul>
{{#site.hours.exceptions}}<li><strong>{{when}}</strong>{{#label}} <span>{{label}}</span>{{/label}} <em>{{hours}}</em></li>
{{/site.hours.exceptions}}</ul>
</div>{{/site.hours.has_exceptions}}
{{#site.hours.note}}<p class="note">{{site.hours.note}}</p>{{/site.hours.note}}
</div>
{{/site.hours.has}}{{#site.contact.has}}<div class="panel contact" id="contact">
<div class="panel-head"><h2>{{strings.contact}}</h2></div>
{{#site.contact.has_address}}<address>{{#site.contact.address_lines}}{{line}}<br>{{/site.contact.address_lines}}</address>{{/site.contact.has_address}}
<ul class="reach">
{{#site.contact.phone}}<li><span class="k">{{strings.call}}</span><a href="{{site.contact.phone_href}}">{{site.contact.phone}}</a></li>{{/site.contact.phone}}
{{#site.contact.email}}<li><span class="k">{{strings.email}}</span><a href="{{site.contact.email_href}}">{{site.contact.email}}</a></li>{{/site.contact.email}}
</ul>
{{#site.contact.map_link}}<a class="b b-block" href="{{site.contact.map_link}}">{{strings.directions}} →</a>{{/site.contact.map_link}}
{{#site.contact.has_social}}<p class="social">{{#site.contact.social}}<a href="{{url}}">{{kind}}</a> {{/site.contact.social}}</p>{{/site.contact.has_social}}
</div>
{{/site.contact.has}}
