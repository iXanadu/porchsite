{{> head}}
<section class="intro"><h1>{{site.tagline}}</h1>{{#page.lede}}<p>{{page.lede}}</p>{{/page.lede}}</section>
{{#has_writing}}<aside class="urgent"><a href="{{page.cta_link}}">{{page.cta_label}} <span aria-hidden="true">→</span></a></aside>{{/has_writing}}
<ol class="parts">
{{#sections}}{{#is_entries}}{{#show}}<li class="part" id="{{stream.anchor}}"><section><header class="part-head"><h2>{{stream.title}}</h2>{{#stream.intro}}<p>{{stream.intro}}</p>{{/stream.intro}}</header><ol class="guide-list">{{#all}}{{> row}}{{/all}}</ol></section></li>{{/show}}{{/is_entries}}{{#is_cards}}{{#show}}<li class="part" id="{{anchor}}"><section><h2>{{title}}</h2>{{#has_projects}}<ul class="guide-list">{{#projects}}{{> card_row}}{{/projects}}</ul>{{/has_projects}}{{#has_open_source}}<h3>{{open_source_label}}</h3><ul class="guide-list">{{#open_source}}{{> card_row}}{{/open_source}}</ul>{{/has_open_source}}</section></li>{{/show}}{{/is_cards}}{{#is_about}}<li class="part" id="{{anchor}}"><section><h2>{{title}}</h2>{{#paragraphs}}<p>{{.}}</p>{{/paragraphs}}</section></li>{{/is_about}}{{/sections}}
</ol>
{{> foot}}
