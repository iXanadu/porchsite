{{> head}}
<article class="page">
<a class="back" href="{{stream.archive_url}}">← {{stream.nav_label}}</a>
<h1>{{entry.title}}</h1>
{{#entry.summary}}<p class="lede">{{entry.summary}}</p>{{/entry.summary}}
<p class="meta">{{entry.date_long}}{{#entry.has_tags}} · {{#entry.tags}}<a href="{{stream.archive_url}}tags/{{name}}/">#{{name}}</a> {{/entry.tags}}{{/entry.has_tags}}</p>
{{#entry}}{{> event}}{{/entry}}
{{#entry.cover_src}}<img class="cover" src="{{entry.cover_src}}" alt="{{entry.cover_alt}}">{{/entry.cover_src}}
{{#entry.has_stats}}<dl class="stats">{{#entry.stats}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/entry.stats}}</dl>{{/entry.has_stats}}
<div class="body">{{{entry.body_html}}}</div>
</article>
{{> foot}}
