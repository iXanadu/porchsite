{{> head}}
<section class="hero{{#site.hero_image}} has-img{{/site.hero_image}}">
<div class="hero-copy">
<h1>{{site.tagline}}</h1>
{{#page.lede}}<p class="lede">{{page.lede}}</p>
{{/page.lede}}{{#has_writing}}<div class="row">
<a class="b" href="{{page.cta_link}}">{{page.cta_label}}</a>
{{#hero_more}}<a class="b b2" href="{{href}}">{{label}}</a>{{/hero_more}}
</div>
{{/has_writing}}</div>
{{#site.hero_image}}<img class="hero-img" src="{{site.hero_image}}" alt="{{page.hero_alt}}" width="{{site.hero_width}}" height="{{site.hero_height}}">
{{/site.hero_image}}{{#site.contact.has}}<aside class="glance">
{{#site.hours.has}}<p class="status{{#site.hours.open_now}} is-open{{/site.hours.open_now}}">{{site.hours.status}}</p>
{{/site.hours.has}}<dl>
{{#site.contact.email}}<dt>{{strings.email}}</dt><dd><a href="{{site.contact.email_href}}">{{site.contact.email}}</a></dd>
{{/site.contact.email}}{{#site.contact.phone}}<dt>{{strings.call}}</dt><dd><a href="{{site.contact.phone_href}}">{{site.contact.phone}}</a></dd>
{{/site.contact.phone}}</dl>
{{#site.contact.has_address}}<p class="m s">{{site.contact.address_one_line}}</p>
{{/site.contact.has_address}}</aside>
{{/site.contact.has}}</section>
{{#sections}}
{{#is_entries}}{{#show}}
<section class="sec" id="{{stream.anchor}}">
<h2>{{stream.title}}</h2>
{{#stream.byline}}<p class="sub">{{stream.byline}}</p>
{{/stream.byline}}{{#stream.intro}}<p>{{stream.intro}}</p>
{{/stream.intro}}{{#stream.is_feature}}{{#latest}}<div class="body feature">
<h3><a href="{{url}}">{{title}}</a></h3>
{{{body_html}}}
</div>
{{/latest}}{{/stream.is_feature}}{{#stream.is_list}}{{#has_upcoming}}<h3 class="k">{{strings.upcoming}}</h3>
<ul class="evs">
{{#upcoming}}{{> event}}{{/upcoming}}</ul>
{{/has_upcoming}}{{#has_earlier}}<h3 class="k">{{strings.earlier}}</h3>
<ul class="evs evs-past">
{{#earlier}}{{> event}}{{/earlier}}</ul>
{{/has_earlier}}{{^has_upcoming}}{{^has_earlier}}<ul class="rows">
{{#items}}{{> page_row}}{{/items}}</ul>
{{/has_earlier}}{{/has_upcoming}}{{/stream.is_list}}{{#more_than_one}}<p class="s"><a href="{{stream.archive_url}}">{{stream.all_label}}{{count_suffix}} →</a></p>
{{/more_than_one}}</section>
{{/show}}{{/is_entries}}
{{#is_cards}}{{#show}}
<div class="groups" id="{{anchor}}">
{{#by_group}}<section class="sec grp g-{{key}}" id="g-{{key}}">
{{#label}}<h2>{{label}}</h2>{{/label}}{{^label}}<h2>{{title}}</h2>{{/label}}
<div class="cards">
{{#cards}}{{> card}}{{/cards}}</div>
</section>
{{/by_group}}</div>
{{/show}}{{/is_cards}}
{{#is_about}}
<section class="sec about" id="{{anchor}}">
<h2>{{title}}</h2>
<div class="about-body">
{{#paragraphs}}<p>{{.}}</p>
{{/paragraphs}}</div>
</section>
{{/is_about}}
{{/sections}}
{{#site.contact.has}}<section class="sec contact" id="contact">
<h2>{{strings.contact}}</h2>
<div class="contact-grid">
<div class="reach">
{{#site.has_buttons}}<ul class="buttons">
{{#site.buttons}}<li><a class="big" href="{{url}}"><strong>{{label}}</strong>{{#note}}<span>{{note}}</span>{{/note}}</a></li>
{{/site.buttons}}</ul>
{{/site.has_buttons}}<dl>
{{#site.contact.email}}<dt>{{strings.email}}</dt><dd><a href="{{site.contact.email_href}}">{{site.contact.email}}</a></dd>
{{/site.contact.email}}{{#site.contact.phone}}<dt>{{strings.call}}</dt><dd><a href="{{site.contact.phone_href}}">{{site.contact.phone}}</a></dd>
{{/site.contact.phone}}</dl>
{{#site.contact.has_address}}<p class="addr">{{#site.contact.address_lines}}{{line}}<br>{{/site.contact.address_lines}}{{#site.contact.map_link}}<a href="{{site.contact.map_link}}">{{strings.directions}} →</a>{{/site.contact.map_link}}</p>
{{/site.contact.has_address}}{{#site.contact.has_social}}<p class="social">{{#site.contact.social}}<a href="{{url}}">{{kind}}</a> {{/site.contact.social}}</p>
{{/site.contact.has_social}}</div>
{{> hours}}</div>
</section>
{{/site.contact.has}}
{{> foot}}
