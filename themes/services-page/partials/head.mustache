<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{meta.title}}</title>
<meta name="description" content="{{meta.description}}">
<meta property="og:title" content="{{meta.title}}">
<meta property="og:description" content="{{meta.description}}">
<meta property="og:type" content="{{meta.og_type}}">
<meta property="og:url" content="{{meta.url}}">
<meta property="og:image" content="{{meta.image}}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{meta.title}}">
<meta name="twitter:description" content="{{meta.description}}">
<meta name="twitter:image" content="{{meta.image}}">
{{#meta.image_alt}}<meta name="twitter:image:alt" content="{{meta.image_alt}}">
{{/meta.image_alt}}{{#site.logo}}<link rel="icon" href="{{site.logo}}">
<link rel="apple-touch-icon" href="{{site.logo}}">
{{/site.logo}}
{{#site.handle}}<meta name="twitter:site" content="@{{site.handle}}">
{{/site.handle}}{{#feeds}}<link rel="alternate" type="application/atom+xml" title="{{title}}" href="{{url}}">
{{/feeds}}<link rel="canonical" href="{{meta.url}}">
<link rel="stylesheet" href="{{kit.css_url}}">
</head>
<body data-kind="{{meta.kind}}" data-id="{{meta.content_id}}">
{{#site.notice.has}}<div class="notice"><p>{{site.notice.text}}</p></div>
{{/site.notice.has}}<div class="w" id="top">
<header class="mast">
<a class="brand" href="/">{{#site.logo}}<img class="brand-mark" src="{{site.logo}}" alt="{{site.logo_alt}}" width="40" height="40">{{/site.logo}}<span>{{site.logo_text}}</span></a>
<nav>
{{#site.links}}<a href="{{url}}">{{label}}</a>
{{/site.links}}{{^site.links}}{{#nav}}<a href="{{href}}">{{label}}</a>
{{/nav}}{{/site.links}}{{#site.contact.has}}<a class="nav-contact" href="/#contact">{{strings.contact}}</a>
{{/site.contact.has}}</nav>
</header>
<main>
