{{#site.hours.has}}<div class="hours">
<h3>{{strings.hours}}</h3>
<p class="status{{#site.hours.open_now}} is-open{{/site.hours.open_now}}">{{site.hours.status}}</p>
<table>
{{#site.hours.days}}<tr{{#today}} class="today"{{/today}}><th scope="row">{{day}}</th><td{{#closed}} class="m"{{/closed}}>{{hours}}</td></tr>
{{/site.hours.days}}</table>
{{#site.hours.has_exceptions}}<ul class="ex">
{{#site.hours.exceptions}}<li><strong>{{label}}</strong> <span>{{when}}</span> <span class="m">{{hours}}</span></li>
{{/site.hours.exceptions}}</ul>
{{/site.hours.has_exceptions}}{{#site.hours.note}}<p class="m s">{{site.hours.note}}</p>
{{/site.hours.note}}</div>
{{/site.hours.has}}
